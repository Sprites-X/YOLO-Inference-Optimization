# TensorRT engines and the INT8 calibration cache — all tied to the GPU and the
# TRT version that built them, so they are useless on another machine.
# .cache.meta.json is the sidecar build_engine.py writes next to each cache;
# *.cache alone does not match it.
*.engine
*.plan
*.cache
*.cache.meta.json

# Models and datasets
*.pt
*.onnx
data/
datasets/
annotations/

# ultralytics scratch output (yolo val/predict writes plots + predictions.json here)
runs/

# Measurement output. fig_*.png is the exception because README.md embeds those two;
# report_table.md is regenerated by make_report.py from the jsonl and is not linked
# anywhere, so it stays out.
*.png
!fig_*.png
report_table.md
# `./run_all.sh 2>&1 | tee sweep.log` is in the README's Reproduce section.
sweep.log
# Half-finished downloads from fetch_train_pool.py, if it is pointed outside data/.
*.part

# python
.venv/
__pycache__/
*.pyc
