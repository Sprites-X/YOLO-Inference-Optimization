# TensorRT engines and the INT8 calibration cache — all tied to the GPU and the
# TRT version that built them, so they are useless on another machine.
# .cache.meta.json is the sidecar build_engine.py writes next to each cache;
# *.cache alone does not match it.
*.engine
*.plan
*.cache
*.cache.meta.json

# Models and datasets
*.pt
*.onnx
data/
datasets/
annotations/

# ultralytics scratch output (yolo val/predict writes plots + predictions.json here)
runs/

# Measurement output
*.png
!fig_*.png
report_table.md

# python
.venv/
__pycache__/
*.pyc
